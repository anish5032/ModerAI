PORT=5000
ML_SERVICE_URL=http://127.0.0.1:8000
# Optional shared secret. Set the same value for the ML service and backend.
ML_API_KEY=
ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_content_moderation
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=200
ALLOW_REGISTRATION=true
CHUNK_SECONDS=2
DEFAULT_DURATION_SECONDS=30
AUDIO_EVENT_MIN_CONFIDENCE=0.3
AUDIO_EVENT_MAX_SECONDS=600
